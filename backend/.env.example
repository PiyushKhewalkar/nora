# Database
MONGODB_URI=
DATABASE_NAME=nora

# AI analysis
OPENAI_API_KEY=

# Image storage
CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# V1 has no auth: the single user every meal belongs to.
# Create a profile via POST /users and paste the returned id here.
DEFAULT_USER_ID=

# IANA timezone the user's calendar days are measured in (e.g. Asia/Kolkata).
# Defaults to UTC, which will file late-night meals on the wrong day.
TIMEZONE=UTC
