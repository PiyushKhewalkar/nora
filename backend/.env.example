# Database
MONGODB_URI=
DATABASE_NAME=nora

# AI analysis
OPENAI_API_KEY=

# Image storage
CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# Signing key for session tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it invalidates every existing login.
JWT_SECRET=

# IANA timezone the user's calendar days are measured in (e.g. Asia/Kolkata).
# Defaults to UTC, which will file late-night meals on the wrong day.
TIMEZONE=UTC
